              <DollarSign size={28} />
            </div>
            <div>
              <span className="text-sm font-black text-gray-400 uppercase tracking-widest">Total Action Revenue</span>
              <h3 className="text-3xl font-black text-gray-900 mt-1">${stats.revenueFulfillment.toFixed(2)}</h3>
