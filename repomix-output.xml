def normalize_to_utc_naive(dt: datetime) -> datetime:
    """Ensure a datetime is converted to UTC and returned as a naive object."""
    if dt.tzinfo is None:
        return dt
    return dt.astimezone(timezone.utc).replace(tzinfo=None)

