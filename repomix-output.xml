          console.error('Failed to fetch municipalities', err);
        }
      };
      fetchMunicipalities();
    } else {
      setAddressMunicipalities([]);
      setAddressZipCodes([]);
      setAddressColonias([]);
    }
  }, [formData.state, token]);

