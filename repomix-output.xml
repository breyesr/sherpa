                        entity_type=entity_type,
                        entity_id=entity.id,
                        content=content,
                        embedding=embedding,
                        metadata_json=metadata
                    )
                    db.add(corpus_entry)
                    total_created += 1
                except Exception as ex:
                    print(f"Error syncing {entity_type} {entity.id}: {ex}")
                    
        await db.commit()
        print(f"Knowledge Corpus Sync complete! Created {total_created} vector search records.")

